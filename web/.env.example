# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. In Vercel, add these as Environment
# Variables (Project → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (Database → Connect → Drivers).
# Include the database name in the path, e.g. ".../eggwhite?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/eggwhite?retryWrites=true&w=majority"

# Auth.js. Generate a secret with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"

# Only needed for local dev; Vercel sets this automatically from the deployment URL.
# AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — https://github.com/settings/developers  (New OAuth App)
# Authorization callback URL: https://YOUR_DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
